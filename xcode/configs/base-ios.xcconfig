ARCHS = $(ARCHS_STANDARD_INCLUDING_64_BIT)
ARCHS[sdk=iphoneos*] = $(ARCHS_STANDARD_INCLUDING_64_BIT)
VALID_ARCHS = i386 x86_64 armv7 armv7s arm64
SDKROOT = iphoneos

// Disable some noisy warnings
GCC_WARN_64_TO_32_BIT_CONVERSION = NO

// disable the GLES1 fixed-function code paths (ES2 contexts only)
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) USE_OPENGLES1=0
